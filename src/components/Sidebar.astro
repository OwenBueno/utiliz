---
import { getToolsByCategory, getToolPath } from '../lib/tool-registry.ts';

interface Props {
  activeTool?: string;
}

const { activeTool } = Astro.props;
const toolsByCategory = getToolsByCategory();
---

<nav class="sidebar" aria-label="Tools">
  {
    [...toolsByCategory.entries()].map(([category, tools]) => (
      <div class="sidebar-section">
        <div class="sidebar-label">{category}</div>
        {tools.map((tool) => (
          <a
            href={getToolPath(tool.slug)}
            class:list={['sidebar-item', { active: activeTool === tool.slug }]}
            aria-current={activeTool === tool.slug ? 'page' : undefined}
          >
            <i class={`ti ti-${tool.icon}`} aria-hidden="true" />
            {tool.name}
          </a>
        ))}
      </div>
    ))
  }
  <div class="sidebar-section sidebar-section--footer">
    <div class="sidebar-label">info</div>
    <div class="sidebar-item sidebar-item--info">
      <i class="ti ti-plug" aria-hidden="true"></i>
      Phase 1 — 3 tools
    </div>
  </div>
</nav>
