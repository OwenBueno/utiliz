---
import AppShell from '../../layouts/AppShell.astro';
import ToolHeader from '../../components/ToolHeader.astro';
import FileSizeWarning from '../../components/FileSizeWarning.astro';
import '../../styles/tools/shared.css';
---

<AppShell title="Image Converter" activeTool="image-converter">
  <div class="tool-pane">
    <ToolHeader slug="image-converter" badge="canvas api" />
    <FileSizeWarning />
    <div class="converter-body">
      <div
        class="drop-zone"
        id="dropZone"
        role="button"
        tabindex="0"
        aria-label="Drop image here or click to upload"
      >
        <input type="file" id="fileInput" accept="image/*" hidden />
        <i class="ti ti-photo-up" aria-hidden="true"></i>
        <span class="drop-zone-text">drop image here or click to upload</span>
        <span class="drop-zone-sub">PNG · JPEG · WebP · AVIF</span>
      </div>
      <div class="preview-area" id="previewArea">
        <img class="preview-img" id="previewImg" alt="Preview" />
        <div class="preview-meta">
          <span class="preview-name" id="imgName"></span>
          <span class="preview-size" id="imgSize"></span>
        </div>
      </div>
      <div class="converter-controls">
        <div class="control-row">
          <span class="control-label">format</span>
          <select class="ctl-select" id="fmtSelect">
            <option value="webp">Convert to WebP</option>
            <option value="jpeg">Convert to JPEG</option>
            <option value="png">Convert to PNG</option>
          </select>
        </div>
        <div class="control-row">
          <span class="control-label">quality</span>
          <input type="range" class="ctl-range" id="qualSlider" min="1" max="100" value="85" />
          <span class="ctl-range-val" id="qualVal">85%</span>
        </div>
        <button type="button" class="convert-btn" id="convertBtn">convert & download</button>
      </div>
    </div>
  </div>
</AppShell>

<script>
  import { initImageConverter } from '../../scripts/tools/image-converter.ts';
  initImageConverter();
</script>
